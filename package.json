{
  "name": "express-addon-review",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Add-on Preflight checks an Adobe Express add-on before submission: the source, the panel, and the listing.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --import ./test/tmp-guard.mjs --test --test-skip-pattern box-test",
    "test:box": "node scripts/box-test.mjs",
    "develop": "node .claude/skills/express-addon-develop/scripts/develop.mjs",
    "scan": "node .claude/skills/express-addon-review/scripts/scan.mjs",
    "review": "node .claude/skills/express-addon-review/scripts/review.mjs",
    "dashboard": "node .claude/skills/express-addon-review/scripts/dashboard.mjs",
    "session": "node .claude/skills/express-addon-review/scripts/session.mjs",
    "render-listing": "node .claude/skills/express-addon-review/scripts/render-listing.mjs",
    "refresh": "node .claude/skills/express-addon-review/scripts/refresh-docs.mjs",
    "link-agents": "node install-agents.mjs"
  }
}
